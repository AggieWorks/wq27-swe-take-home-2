# ----- BACKEND (Docker Compose) -----
# Use POSTGRES_HOST=db when running via compose; use localhost when running the API on the host.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dibs_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Auth (required for Google sign-in flows)
JWT_SECRET=local-dev-change-me
GAUTH_CLIENT_ID=
GAUTH_CLIENT_SECRET=
GAUTH_CLIENT_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# ----- FRONTEND -----
NEXT_PUBLIC_BASE_API_URL=http://localhost:8080

# Optional analytics / maps (leave blank for local take-home)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
